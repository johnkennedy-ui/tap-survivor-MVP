    "allowJs": true,
    "checkJs": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "strict": false,
    "target": "ES2023",
    "types": ["node"]
  },
  "include": [
    "types/**/*.d.ts",
    "scripts/content-tools.mjs",
    "scripts/content/*.mjs",
    "src/content-registry.js"
  ]
}
