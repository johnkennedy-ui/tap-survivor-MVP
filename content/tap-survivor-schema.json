{
  "schemaVersion": 1,
  "idConvention": "lowercase snake_case",
  "contentTypes": {
    "weapon": {
      "collection": "weapons",
      "idPattern": "<weapon_id>",
      "generatedFields": [
        "upgradeId"
      ]
    },
    "quest": {
      "collection": "quests",
      "idPattern": "<quest_id>",
      "groupedBy": "questGroups"
    },
    "shopItem": {
      "collection": "shopItems",
      "defaultKind": "stat_upgrade",
      "defaultMaxTier": 1
    },
    "runUpgrade": {
      "collection": "runUpgrades"
    },
    "relic": {
      "collection": "relics"
    },
    "level": {
      "collection": "levels"
    },
    "character": {
      "collection": "characters"
    },
    "enemy": {
      "collection": "enemyTypes"
    },
    "boss": {
      "collection": "bossAbilities",
      "configCollection": "bossConfig"
    },
    "floor": {
      "collection": "levels"
    },
    "map": {
      "collection": "maps"
    },
    "audio": {
      "collection": "assets.sfx"
    },
    "assets": {
      "collection": "assets"
    }
  },
  "templates": {
    "weapon": {
      "defaults": {
        "cooldown": 1,
        "damage": 10,
        "kind": "projectile",
        "speed": 320,
        "radius": 8,
        "color": "#ffffff",
        "unlockCost": 1,
        "branch": "Core"
      }
    },
    "quest": {
      "defaults": {
        "target": 1,
        "rewardQp": 1
      }
    },
    "shopItem": {
      "defaults": {
        "kind": "stat_upgrade",
        "cost": 100,
        "maxTier": 1,
        "effectValue": 0
      }
    },
    "runUpgrade": {
      "defaults": {
        "maxTier": 1,
        "effects": [
          {
            "type": "playerStatAdd",
            "stat": "speed",
            "value": 0
          }
        ]
      }
    },
    "relic": {
      "defaults": {
        "targetUpgradeId": "run_fire_rate",
        "selectionWeightBonus": 1,
        "startingTierBonus": 0,
        "maxTierBonus": 0,
        "iconPath": "assets/kenney/desert-shooter/ui-quest.png?v=kenney-20260610"
      }
    },
    "enemy": {
      "defaults": {
        "name": "New Enemy",
        "color": "#ffffff",
        "radius": 14,
        "hp": 20,
        "speed": 70,
        "damage": 8,
        "xp": 1,
        "minTowerFloor": 1,
        "behaviorKind": "chaser",
        "assetId": "drifter"
      }
    },
    "boss": {
      "defaults": {
        "name": "New Boss Ability",
        "color": "#ff4f8b",
        "speed": 42,
        "attackCooldown": 3.2
      }
    },
    "floor": {
      "defaults": {
        "name": "New Floor",
        "startsAt": 0,
        "enemyIds": [
          "drifter"
        ],
        "spawnCount": 2,
        "spawnRateMultiplier": 1
      }
    },
    "map": {
      "defaults": {
        "name": "New Map",
        "floorIds": [],
        "backgroundAsset": "assets/generated/tower/tower-floor-bg.png?v=generated-20260610",
        "modifiers": {}
      }
    },
    "character": {
      "defaults": {
        "spriteId": "player",
        "notes": ""
      }
    }
  },
  "fieldRules": {
    "shopItem": {
      "required": [
        "id",
        "name",
        "description",
        "kind",
        "cost",
        "maxTier"
      ],
      "kinds": [
        "stat_upgrade"
      ],
      "cost": {
        "min": 0,
        "arrayLengthMustMatchMaxTier": true,
        "tiersMustIncrease": true
      },
      "maxTier": {
        "min": 1
      },
      "effect": {
        "optional": true,
        "statRegistry": "effectRegistries.shopItem.stats",
        "valueMin": 0
      }
    }
  },
  "effectRegistries": {
    "runUpgrade": {
      "types": [
        "playerStatAdd",
        "playerHeal"
      ],
      "playerStatAddStats": [
        "speed",
        "pickupRadius",
        "maxHp"
      ]
    },
    "shopItem": {
      "stats": [
        "speed",
        "pickupRadius",
        "maxHp",
        "flatDamage",
        "attackRadius",
        "fireRate",
        "percentDamage",
        "relicFocus"
      ]
    },
    "relic": {
      "modifierStats": [
        "areaRadiusBonus",
        "beamWidthBonus",
        "blinkInvulnerabilitySeconds",
        "bossDamageBonus",
        "coinMultiplier",
        "cooldownReduction",
        "damageBonus",
        "damageReduction",
        "dodgeChance",
        "doubleShotCount",
        "killExplosionDamage",
        "killExplosionRadius",
        "lifestealOnKill",
        "maxHpBonus",
        "maxHpMultiplier",
        "pickupRadiusMultiplier",
        "projectileSizeBonus",
        "projectileSpeedBonus",
        "speedMultiplier",
        "teleportDistance",
        "teleportOnHitCooldown",
        "thornDamage",
        "xpMultiplier"
      ]
    }
  },
  "behaviorRegistries": {
    "weaponKinds": {
      "runtime": "src/weapon-fire.js",
      "ids": [
        "radial",
        "beam",
        "cone",
        "chain",
        "projectile",
        "target_area",
        "lingering_area",
        "mine"
      ]
    },
    "bossAbilityKinds": {
      "runtime": "src/enemies.js",
      "ids": [
        "warden",
        "charger",
        "turret"
      ]
    },
    "enemyBehaviorKinds": {
      "runtime": "src/enemy-spawning.js",
      "ids": [
        "chaser",
        "ranged"
      ]
    },
    "relicSpecialKinds": {
      "runtime": "src/relics.js",
      "ids": [
        "modifiers"
      ]
    }
  },
  "validationCommands": {
    "contentOnly": [
      "npm run build:content",
      "npm run validate:content"
    ],
    "questOrUnlock": [
      "npm run audit:quests"
    ],
    "runtimeAffected": [
      "npm test"
    ],
    "ship": [
      "npm run agent:ship -- --message \"<commit message>\""
    ]
  },
  "contentModel": {
    "registryDir": "content/registry",
    "balanceDir": "content/balance",
    "domains": {
      "weapons": "content/registry/weapons.json",
      "relics": "content/registry/relics.json",
      "shopItems": "content/registry/shop-items.json",
      "runUpgrades": "content/registry/run-upgrades.json",
      "enemies": "content/registry/enemies.json",
      "bosses": "content/registry/bosses.json",
      "floors": "content/registry/floors.json",
      "maps": "content/registry/maps.json",
      "quests": "content/registry/quests.json",
      "characters": "content/registry/characters.json",
      "assets": "content/registry/assets.json",
      "audio": "content/registry/audio.json",
      "tuning": "content/registry/tuning.json"
    }
  },
  "balanceProfiles": {
    "default": "content/balance/default.json",
    "examples": [
      "content/balance/dev-fast.json",
      "content/balance/testing.json"
    ]
  }
}
